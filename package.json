{
  "name": "sawitheight-r-desktop",
  "version": "0.6.0",
  "description": "MAS POPO desktop: rolling 2-period monitoring tinggi relatif P95, terrain hold-out QC, presence support, technical uncertainty, peer-based residual, residual zone, dan live process log.",
  "main": "src/main.js",
  "author": "PMNP",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "verify": "node scripts/verify_project.js",
    "dist": "electron-builder --win --x64 --publish never",
    "dist:portable": "electron-builder --win portable --x64 --publish never",
    "dist:installer": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "43.0.0",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "com.pmnp.sawitheight",
    "productName": "SawitHeight R",
    "asar": true,
    "directories": { "output": "dist" },
    "files": [
      "src/**/*",
      "assets/**/*",
      "r/**/*",
      "package.json"
    ],
    "extraResources": [
      "r/**/*",
      {
        "from": "docs/reference_tutorial.html",
        "to": "docs/reference_tutorial.html"
      },
      {
        "from": "vendor/R",
        "to": "vendor/R",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        { "target": "portable", "arch": ["x64"] },
        { "target": "nsis", "arch": ["x64"] }
      ]
    },
    "portable": {
      "artifactName": "SawitHeight-R-Portable-${version}.exe",
      "requestExecutionLevel": "user"
    },
    "nsis": {
      "artifactName": "SawitHeight-R-Setup-${version}.exe",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SawitHeight R"
    },
    "asarUnpack": ["r/**/*"]
  }
}
